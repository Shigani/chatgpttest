          toPanel.style.height = `${fromHeight}px`;
          toPanel.classList.add('site-header__dropdown-panel--switch-height');
          void toPanel.offsetHeight;
          toPanel.classList.remove('site-header__dropdown-panel--instant');
          animation.startedAt = performance.now();
          toPanel.addEventListener('transitionend', finish);
          animation.timer = window.setTimeout(finish, 360);
          window.setTimeout(() => {
            if (switchHeightAnimationHandlers.get(toPanel) === animation) {
              toPanel.style.height = `${toHeight}px`;
            }
          }, 0);
        };

        animation.frameId = window.setTimeout(settleTargetHeight, 16);
      };
      const openDropdown = (dropdown) => {
        window.clearTimeout(dropdownCloseTimer);
        const panel = dropdown.querySelector('.site-header__dropdown-panel');
        const activeDropdown = dropdowns.find((item) => item !== dropdown && item.open);

        if (activeDropdown) {
          switchDropdown(activeDropdown, dropdown);
          return;
        }

        if (dropdown.open) {
          if (!panel?.classList.contains('site-header__dropdown-panel--closing')) return;

          cancelClosingAnimation(panel);
          panel.classList.remove('site-header__dropdown-panel--replay');
          void panel.offsetWidth;
          panel.classList.add('site-header__dropdown-panel--replay');
          return;
        }

        closeDropdowns(dropdown);
        dropdown.setAttribute('open', '');
        syncDropdownState();

        if (!panel) return;

        cancelClosingAnimation(panel);
        panel.classList.remove('site-header__dropdown-panel--replay');
        void panel.offsetWidth;
        panel.classList.add('site-header__dropdown-panel--replay');
      };

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (dropdown.open) closeDropdowns(dropdown);
          syncDropdownState();
        });

        dropdown.querySelector('summary')?.addEventListener('click', (event) => {
          if (canHover && event.detail > 0) {
            event.preventDefault();
            openDropdown(dropdown);
          }
        });

        dropdown.querySelector('summary')?.addEventListener('pointerenter', () => {
          if (canHover) openDropdown(dropdown);
        });
      });

      header.querySelectorAll('[data-site-header-deal-carousel]').forEach((carousel) => {
        const viewport = carousel.querySelector('[data-site-header-deals-viewport]');
        const track = carousel.querySelector('.site-header__mega-menu-deals-track');
        const previousButton = carousel.querySelector('[data-site-header-deals-prev]');
        const nextButton = carousel.querySelector('[data-site-header-deals-next]');
        if (!viewport || !track || !previousButton || !nextButton) return;

        const updateDealCarousel = () => {
          const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
          const cardWidth = Math.max((viewport.clientWidth - gap * 2) / 3, 0);
          carousel.style.setProperty('--site-header-deal-card-width', `${cardWidth}px`);
        };
        const scrollDeals = (direction) => {
          viewport.scrollBy({ left: direction * viewport.clientWidth, behavior: 'smooth' });
        };

        previousButton.addEventListener('click', () => scrollDeals(-1));
        nextButton.addEventListener('click', () => scrollDeals(1));
        viewport.addEventListener('scroll', updateDealCarousel, { passive: true });
        window.addEventListener('resize', updateDealCarousel);
        carousel.closest('[data-site-header-dropdown]')?.addEventListener('toggle', updateDealCarousel);
        if (window.ResizeObserver) new ResizeObserver(updateDealCarousel).observe(viewport);
        window.requestAnimationFrame(updateDealCarousel);
      });

      header.querySelectorAll('.site-header__navigation > :not([data-site-header-dropdown])').forEach((menuItem) => {
        menuItem.addEventListener('pointerenter', () => {
          if (!canHover) return;

          window.clearTimeout(dropdownCloseTimer);
          closeDropdowns();
        });
      });

      header.addEventListener('pointerenter', () => {
        window.clearTimeout(dropdownCloseTimer);
      });

      header.addEventListener('pointerleave', (event) => {
        if (!canHover || isInsideHeader(event.relatedTarget) || header.matches(':focus-within')) return;

        window.clearTimeout(dropdownCloseTimer);
        dropdownCloseTimer = window.setTimeout(() => {
          if (!header.matches(':hover') && !header.matches(':focus-within')) closeDropdowns();
        }, dropdownCloseDelay);
      });

      document.addEventListener('pointerdown', (event) => {
        if (!header.contains(event.target)) closeDropdowns();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        if (mobileMenuOpen) {
          event.preventDefault();
          setMobileMenuOpen(false);
          return;
        }

        const openDropdown = dropdowns.find((dropdown) => dropdown.open);
        if (!openDropdown) return;

        closeDropdown(openDropdown);
        openDropdown.querySelector('summary')?.focus();
      });

      syncDropdownState();
      header.dataset.siteHeaderInitialized = 'true';
    });
  };

  initializeSiteHeaders();
  document.addEventListener('DOMContentLoaded', () => initializeSiteHeaders());
  document.addEventListener('shopify:section:load', (event) => initializeSiteHeaders(event.target));
{% endjavascript %}

