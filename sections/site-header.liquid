<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <button class="site-header__menu-toggle" type="button" aria-label="{{ 'header.menu' | t }}" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-header__navigation" aria-label="{{ 'header.primary_navigation' | t }}">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <details class="site-header__dropdown" data-site-header-dropdown>
              <summary class="site-header__dropdown-trigger" aria-controls="site-header-dropdown-{{ section.id }}-{{ forloop.index }}">
                <span>{{ link.title | escape }}</span>
                <svg class="site-header__dropdown-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="site-header__dropdown-panel" id="site-header-dropdown-{{ section.id }}-{{ forloop.index }}">
                <ul class="site-header__dropdown-list" role="list">
                  {% for child_link in link.links %}
                    <li>
                      <a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                      {% if child_link.links != blank %}
                        <ul class="site-header__dropdown-sublist" role="list">
                          {% for grandchild_link in child_link.links %}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.catalog' | t }}</a>
        <a href="/pages/contact">{{ 'header.contact' | t }}</a>
      {% endif %}
    </nav>

    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__search" href="{{ routes.search_url }}">
        <span>{{ 'header.search_prompt' | t }}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M5 21a7 7 0 0 1 14 0"></path>
        </svg>
      </a>

      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.2 10h10.9l2-7H7"></path>
          <circle cx="9" cy="19" r="1"></circle>
          <circle cx="18" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: fixed;
    top: clamp(0.75rem, 2.5vh, 1.5rem);
    right: 3.125rem;
    left: 3.125rem;
    z-index: 20;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 5rem;
    padding: 0 clamp(1rem, 2.5vw, 1.95rem);
    border: 1px solid rgb(11 11 11 / 0.06);
    border-radius: 1rem;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.08);
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 350ms ease, border-color 350ms ease, border-radius 350ms ease, box-shadow 350ms ease, color 350ms ease;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    padding-inline: 0;
  }

  .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
    border-color: transparent;
    background: transparent;
    color: #ffffff;
    box-shadow: none;
  }

  .site-header__navigation,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__navigation {
    justify-self: start;
    gap: clamp(1.35rem, 2.15vw, 2rem);
  }

  .site-header__actions {
    justify-self: end;
    gap: 1.2rem;
  }

  .site-header__menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__navigation a {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-header__dropdown {
    position: relative;
  }

  .site-header__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0;
    color: inherit;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    list-style: none;
  }

  .site-header__dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__dropdown-trigger::marker {
    content: '';
  }

  .site-header__dropdown-chevron {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 180ms ease;
  }

  .site-header__dropdown[open] > .site-header__dropdown-trigger .site-header__dropdown-chevron {
    transform: rotate(180deg);
  }

  .site-header__dropdown-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: -0.85rem;
    z-index: 1;
    min-width: 14rem;
    padding: 0.55rem;
    border: 1px solid rgb(11 11 11 / 0.08);
    border-radius: 0.75rem;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.4rem);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    visibility: hidden;
  }

  .site-header__dropdown-panel::before {
    position: absolute;
    top: -0.75rem;
    right: 0;
    left: 0;
    height: 0.75rem;
    content: '';
  }

  .site-header__dropdown[open] > .site-header__dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .site-header__dropdown-list,
  .site-header__dropdown-sublist {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__dropdown-list a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .site-header__dropdown-list a:hover {
    background: rgb(11 11 11 / 0.06);
    opacity: 1;
  }

  .site-header__dropdown-sublist {
    margin: 0.1rem 0 0.25rem;
    padding: 0.25rem 0 0.25rem 0.65rem;
    border-left: 1px solid rgb(11 11 11 / 0.12);
  }

  .site-header__dropdown-sublist a {
    min-height: 2.15rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.85rem;
  }

  .site-header__brand {
    justify-self: center;
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1;
    text-align: center;
  }

  .site-header__search {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3.6vw, 3rem);
    color: inherit;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .site-header svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .site-header__icon {
    display: grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
  }

  .site-header a:hover,
  .site-header__menu-toggle:hover {
    opacity: 0.62;
  }

  .site-header a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header--hidden {
    transform: translateY(calc(-100% - 1rem));
  }

  @media (max-width: 990px) {
    .site-header {
      top: 0;
      right: 0;
      left: 0;
    }

    .site-header__bar {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      min-height: 4.25rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: 0 1px 0 rgb(11 11 11 / 0.14);
    }

    .site-header__navigation {
      display: none;
    }

    .site-header__dropdown-panel {
      display: none;
    }

    .site-header__menu-toggle {
      display: grid;
      width: 3.5rem;
      height: 4.25rem;
      place-items: center;
    }

    .site-header__brand {
      justify-self: start;
      width: min(100%, 8.25rem);
      min-width: 0;
      padding: 0.5rem 0.9rem;
      font-size: 1.25rem;
      line-height: 1.05;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .site-header__search span:not(.visually-hidden) {
      display: none;
    }

    .site-header__search {
      gap: 0;
    }

    .site-header__actions {
      gap: 0;
    }

    .site-header__search,
    .site-header__icon {
      width: 3.75rem;
      height: 4.25rem;
      justify-content: center;
    }

    .site-header__account {
      display: none;
    }

    .site-header--hidden {
      transform: translateY(-100%);
    }

    .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
      box-shadow: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__bar,
    .site-header__dropdown-chevron,
    .site-header__dropdown-panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initializeSiteHeaders = (root = document) => {
    root.querySelectorAll('[data-site-header]').forEach((header) => {
      if (header.dataset.siteHeaderInitialized === 'true') return;

      let lastScrollY = window.scrollY;

      const updateHeader = () => {
        const currentScrollY = Math.max(window.scrollY, 0);
        const isScrolled = currentScrollY > 12;
        const isMobile = window.matchMedia('(max-width: 990px)').matches;

        header.classList.toggle('site-header--scrolled', isScrolled);

        if (!isMobile) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY <= 24 || currentScrollY < lastScrollY - 2) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY > lastScrollY + 2 && currentScrollY > 80) {
          header.classList.add('site-header--hidden');
        }

        lastScrollY = currentScrollY;
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
      window.addEventListener('resize', updateHeader);

      const dropdowns = [...header.querySelectorAll('[data-site-header-dropdown]')];
      const closeDropdowns = (except = null) => {
        dropdowns.forEach((dropdown) => {
          if (dropdown !== except) dropdown.removeAttribute('open');
        });
      };

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (dropdown.open) closeDropdowns(dropdown);
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!header.contains(event.target)) closeDropdowns();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        const openDropdown = dropdowns.find((dropdown) => dropdown.open);
        if (!openDropdown) return;

        openDropdown.removeAttribute('open');
        openDropdown.querySelector('summary')?.focus();
      });

      header.dataset.siteHeaderInitialized = 'true';
    });
  };

  initializeSiteHeaders();
  document.addEventListener('DOMContentLoaded', () => initializeSiteHeaders());
  document.addEventListener('shopify:section:load', (event) => initializeSiteHeaders(event.target));
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.site_header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

