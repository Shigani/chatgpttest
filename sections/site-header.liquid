<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <button class="site-header__menu-toggle" type="button" aria-label="{{ 'header.menu' | t }}" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-header__navigation" aria-label="{{ 'header.primary_navigation' | t }}">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            {% assign menu_handle = link.title | handleize %}
            {% assign has_promo_blocks = false %}
            {% for block in section.blocks %}
              {% if block.type == 'mega_menu_promo' %}
                {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                  {% if block.settings.image != blank %}
                    {% assign has_promo_blocks = true %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}

            <details class="site-header__dropdown" data-site-header-dropdown data-action="hover">
              <summary class="site-header__dropdown-trigger" aria-controls="site-header-mega-{{ section.id }}-{{ forloop.index }}" aria-haspopup="true">
                <span>{{ link.title | escape }}</span>
                <svg class="site-header__dropdown-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="site-header__dropdown-panel{% if has_promo_blocks %} site-header__dropdown-panel--with-promos{% endif %}" id="site-header-mega-{{ section.id }}-{{ forloop.index }}">
                <div class="site-header__mega-menu-inner">
                  <div class="site-header__mega-menu-links">
                    {% assign has_direct_links = false %}
                    {% for child_link in link.links %}
                      {% if child_link.links == blank %}
                        {% assign has_direct_links = true %}
                      {% endif %}
                    {% endfor %}

                    {% if has_direct_links %}
                      <div class="site-header__mega-menu-column site-header__mega-menu-column--direct">
                        <ul class="site-header__mega-menu-list" role="list">
                          {% for child_link in link.links %}
                            {% if child_link.links == blank %}
                              <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% for child_link in link.links %}
                      {% if child_link.links != blank %}
                        <div class="site-header__mega-menu-column">
                          <a class="site-header__mega-menu-title" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                          <ul class="site-header__mega-menu-list" role="list">
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if has_promo_blocks %}
                    <div class="site-header__mega-menu-promos">
                      {% for block in section.blocks %}
                        {% if block.type == 'mega_menu_promo' %}
                          {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                            {% if block.settings.image != blank %}
                              <a class="site-header__mega-menu-promo" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.root_url }}{% endif %}" {{ block.shopify_attributes }}>
                                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
                                <span class="site-header__mega-menu-promo-caption">
                                  <span>{{ block.settings.title | default: link.title | escape }}</span>
                                  <span aria-hidden="true">↗</span>
                                </span>
                              </a>
                            {% endif %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.catalog' | t }}</a>
        <a href="/pages/contact">{{ 'header.contact' | t }}</a>
      {% endif %}
    </nav>

    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__search" href="{{ routes.search_url }}">
        <span>{{ 'header.search_prompt' | t }}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M5 21a7 7 0 0 1 14 0"></path>
        </svg>
      </a>

      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.2 10h10.9l2-7H7"></path>
          <circle cx="9" cy="19" r="1"></circle>
          <circle cx="18" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    --site-header-top: clamp(0.75rem, 2.5vh, 1.5rem);
    position: fixed;
    top: var(--site-header-top);
    right: 3.125rem;
    left: 3.125rem;
    z-index: 20;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 5rem;
    padding: 0 clamp(1rem, 2.5vw, 1.95rem);
    border: 1px solid rgb(11 11 11 / 0.06);
    border-radius: 1rem;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.08);
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 350ms ease, border-color 350ms ease, border-radius 350ms ease, box-shadow 350ms ease, color 350ms ease;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    padding-inline: 0;
  }

  .site-header:not(.site-header--scrolled) {
    --site-header-top: 0;
    top: 0;
    right: 0;
    left: 0;
    background: #ffffff;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    margin-inline: 3.125rem;
    border-color: transparent;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
  }

  .template-index .site-header:not(.site-header--scrolled) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
    background: transparent;
    color: #ffffff;
    box-shadow: none;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) {
    background: #ffffff;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) .site-header__bar {
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
  }

  .site-header__navigation,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__navigation {
    justify-self: start;
    gap: clamp(1.35rem, 2.15vw, 2rem);
  }

  .site-header__actions {
    justify-self: end;
    gap: 1.2rem;
  }

  .site-header__menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__navigation a {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-header__dropdown {
    position: static;
  }

  .site-header__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0;
    color: inherit;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    list-style: none;
  }

  .site-header__dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__dropdown-trigger::marker {
    content: '';
  }

  .site-header__dropdown-trigger > span:first-child {
    position: relative;
  }

  .site-header__dropdown-trigger > span:first-child::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .site-header__dropdown:hover > .site-header__dropdown-trigger > span:first-child::after,
  .site-header__dropdown[open] > .site-header__dropdown-trigger > span:first-child::after {
    transform: scaleX(1);
  }

  .site-header__dropdown-chevron {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 180ms ease;
  }

  .site-header__dropdown[open] > .site-header__dropdown-trigger .site-header__dropdown-chevron {
    transform: rotate(180deg);
  }

  .site-header__dropdown-panel {
    position: absolute;
    top: 5rem;
    right: 0;
    left: 0;
    z-index: 1;
    padding: 0;
    border-top: 1px solid rgb(11 11 11 / 0.08);
    border-bottom: 1px solid rgb(11 11 11 / 0.08);
    border-radius: 0;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.08);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    visibility: hidden;
  }

  .site-header__dropdown[open] > .site-header__dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .site-header__mega-menu-inner {
    display: flex;
    align-items: flex-start;
    gap: clamp(2rem, 4vw, 5rem);
    width: 100%;
    padding: 2.5rem clamp(1.25rem, 2.6vw, 3.125rem);
  }

  .site-header__mega-menu-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: start;
    gap: 2rem;
    width: min(100%, 37.5rem);
  }

  .site-header__dropdown-panel--with-promos .site-header__mega-menu-links {
    flex: 0 0 min(37.5rem, 45%);
  }

  .site-header__mega-menu-column {
    min-width: 0;
  }

  .site-header__mega-menu-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__mega-menu a {
    color: inherit;
    font-size: 0.9rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .site-header__mega-menu-column--direct a {
    font-weight: 650;
  }

  .site-header__mega-menu-title {
    display: flex;
    align-items: center;
    min-height: 1.35rem;
    margin-bottom: 1rem;
  }

  .site-header__mega-menu a:hover {
    opacity: 0.62;
  }

  .site-header__mega-menu-promos {
    display: grid;
    flex: 1 1 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    min-width: 0;
  }

  .site-header__mega-menu-promo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-header__mega-menu-promo img {
    display: block;
    width: 100%;
    aspect-ratio: 1.49;
    border-radius: 0.8rem;
    object-fit: cover;
  }

  .site-header__mega-menu-promo-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .site-header__brand {
    justify-self: center;
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1;
    text-align: center;
  }

  .site-header__search {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3.6vw, 3rem);
    color: inherit;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .site-header svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .site-header__icon {
    display: grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
  }

  .site-header a:hover,
  .site-header__menu-toggle:hover {
    opacity: 0.62;
  }

  .site-header a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header--hidden {
    transform: translateY(calc(-100% - 1rem));
  }

  @media (max-width: 990px) {
    .site-header {
      --site-header-top: 0;
      top: 0;
      right: 0;
      left: 0;
    }

    .site-header:not(.site-header--scrolled) .site-header__bar {
      margin-inline: 0;
    }

    .site-header__bar {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      min-height: 4.25rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: 0 1px 0 rgb(11 11 11 / 0.14);
    }

    .site-header__navigation {
      display: none;
    }

    .site-header__dropdown-panel {
      display: none;
    }

    .site-header__menu-toggle {
      display: grid;
      width: 3.5rem;
      height: 4.25rem;
      place-items: center;
    }

    .site-header__brand {
      justify-self: start;
      width: min(100%, 8.25rem);
      min-width: 0;
      padding: 0.5rem 0.9rem;
      font-size: 1.25rem;
      line-height: 1.05;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .site-header__search span:not(.visually-hidden) {
      display: none;
    }

    .site-header__search {
      gap: 0;
    }

    .site-header__actions {
      gap: 0;
    }

    .site-header__search,
    .site-header__icon {
      width: 3.75rem;
      height: 4.25rem;
      justify-content: center;
    }

    .site-header__account {
      display: none;
    }

    .site-header--hidden {
      transform: translateY(-100%);
    }

    .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
      box-shadow: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__bar,
    .site-header__dropdown-chevron,
    .site-header__dropdown-trigger > span:first-child::after,
    .site-header__dropdown-panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initializeSiteHeaders = (root = document) => {
    root.querySelectorAll('[data-site-header]').forEach((header) => {
      if (header.dataset.siteHeaderInitialized === 'true') return;

      let lastScrollY = window.scrollY;

      const updateHeader = () => {
        const currentScrollY = Math.max(window.scrollY, 0);
        const isScrolled = currentScrollY > 12;
        const isMobile = window.matchMedia('(max-width: 990px)').matches;

        header.classList.toggle('site-header--scrolled', isScrolled);

        if (!isMobile) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY <= 24 || currentScrollY < lastScrollY - 2) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY > lastScrollY + 2 && currentScrollY > 80) {
          header.classList.add('site-header--hidden');
        }

        lastScrollY = currentScrollY;
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
      window.addEventListener('resize', updateHeader);

      const dropdowns = [...header.querySelectorAll('[data-site-header-dropdown]')];
      const closeDropdowns = (except = null) => {
        dropdowns.forEach((dropdown) => {
          if (dropdown !== except) dropdown.removeAttribute('open');
        });
      };
      const canHover = window.matchMedia('(hover: hover)').matches;
      const openDropdown = (dropdown) => {
        closeDropdowns(dropdown);
        dropdown.setAttribute('open', '');
      };

      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (dropdown.open) closeDropdowns(dropdown);
        });

        dropdown.addEventListener('pointerenter', () => {
          if (canHover) openDropdown(dropdown);
        });

        dropdown.addEventListener('pointerleave', () => {
          if (!canHover || dropdown.matches(':focus-within')) return;

          window.setTimeout(() => {
            if (!dropdown.matches(':hover') && !dropdown.matches(':focus-within')) dropdown.removeAttribute('open');
          }, 180);
        });

        dropdown.querySelector('summary')?.addEventListener('click', (event) => {
          if (canHover && event.detail > 0) {
            event.preventDefault();
            openDropdown(dropdown);
          }
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!header.contains(event.target)) closeDropdowns();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        const openDropdown = dropdowns.find((dropdown) => dropdown.open);
        if (!openDropdown) return;

        openDropdown.removeAttribute('open');
        openDropdown.querySelector('summary')?.focus();
      });

      header.dataset.siteHeaderInitialized = 'true';
    });
  };

  initializeSiteHeaders();
  document.addEventListener('DOMContentLoaded', () => initializeSiteHeaders());
  document.addEventListener('shopify:section:load', (event) => initializeSiteHeaders(event.target));
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.site_header.name",
  "blocks": [
    {
      "type": "mega_menu_promo",
      "name": "t:sections.site_header.blocks.mega_menu_promo.name",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:sections.site_header.blocks.mega_menu_promo.settings.menu_item.label",
          "info": "t:sections.site_header.blocks.mega_menu_promo.settings.menu_item.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.site_header.blocks.mega_menu_promo.settings.title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
