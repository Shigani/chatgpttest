<header class="site-header">
  <div class="site-header__bar">
    <button class="site-header__menu-toggle" type="button" aria-label="{{ 'header.menu' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-header__navigation" aria-label="{{ 'header.primary_navigation' | t }}">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.catalog' | t }}</a>
        <a href="/pages/contact">{{ 'header.contact' | t }}</a>
      {% endif %}
    </nav>

    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__search" href="{{ routes.search_url }}">
        <span>{{ 'header.search_prompt' | t }}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M5 21a7 7 0 0 1 14 0"></path>
        </svg>
      </a>

      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.2 10h10.9l2-7H7"></path>
          <circle cx="9" cy="19" r="1"></circle>
          <circle cx="18" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: absolute;
    top: clamp(1rem, 3.9vh, 1.7rem);
    right: clamp(1rem, 3.9vw, 3.15rem);
    left: clamp(1rem, 3.9vw, 3.15rem);
    z-index: 20;
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 5rem;
    padding: 0 1.95rem;
    border-radius: 0.65rem;
    background: #ffffff;
    color: #0b0b0b;
  }

  .site-header__navigation,
  .site-header__actions,
  .site-header__menu-toggle {
    display: flex;
    align-items: center;
  }

  .site-header__menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__navigation {
    gap: clamp(1.35rem, 2.15vw, 2rem);
  }

  .site-header__actions {
    justify-content: flex-end;
    gap: 1.45rem;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__navigation a {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-header__brand {
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .site-header__search {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3.6vw, 3rem);
    color: #5b5b5b;
    font-size: 0.95rem;
  }

  .site-header svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .site-header__icon {
    display: grid;
    place-items: center;
  }

  .site-header a:hover {
    opacity: 0.62;
  }

  .site-header a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 899px) {
    .site-header {
      position: relative;
      top: 0;
      right: 0;
      left: 0;
    }

    .site-header__bar {
      grid-template-columns: auto 1fr auto;
      min-height: 4.5rem;
      padding: 0;
      border-radius: 0;
    }

    .site-header__navigation {
      display: none;
    }

    .site-header__menu-toggle {
      display: grid;
      width: 3.5rem;
      height: 4.5rem;
      border-right: 1px solid #dedede;
      place-items: center;
    }

    .site-header__brand {
      justify-self: start;
      min-width: 0;
      padding: 0 1rem;
    }

    .site-header__search span:not(.visually-hidden) {
      display: none;
    }

    .site-header__search {
      gap: 0;
    }

    .site-header__actions {
      gap: 0;
    }

    .site-header__search,
    .site-header__icon {
      width: 3.75rem;
      height: 4.5rem;
      justify-content: center;
      border-left: 1px solid #dedede;
    }
  }

  @media (max-width: 479px) {
    .site-header__search {
      display: flex;
    }

    .site-header__account {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.site_header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

