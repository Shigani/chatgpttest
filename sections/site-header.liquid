        if (!mobileMenuOpen && !mobileMenu.classList.contains('is-closing')) return;

        mobileMenuOpen = false;
        mobileMenu.classList.remove('is-open');
        mobileMenu.classList.add('is-closing');
        mobileMenu.setAttribute('aria-hidden', 'true');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
        mobileMenuCloseTimer = window.setTimeout(() => {
          mobileMenu.classList.remove('is-closing');
          header.classList.remove('site-header--menu-open');
          resetMobileMenuView();
          updateMobileMenuScrollLock(false);
          mobileMenuToggle.focus();
        }, mobileMenuTransitionDuration + 20);
      };
      mobileMenuToggle?.addEventListener('click', () => {
        setMobileMenuOpen(!mobileMenuOpen);
      });
      mobileMenu?.querySelectorAll('[data-site-header-mobile-subpopup-back]').forEach((backButton) => {
        backButton.addEventListener('click', () => {
          setMobileMenuView(backButton.dataset.mobileMenuTarget || 'root', 'back');
        });
      });
      mobileMenu?.querySelectorAll('[data-site-header-mobile-close]').forEach((closeButton) => {
        closeButton.addEventListener('click', () => setMobileMenuOpen(false));
      });
      mobileMenu?.querySelectorAll('[data-site-header-mobile-next]').forEach((nextButton) => {
        nextButton.addEventListener('click', () => {
          setMobileMenuView(nextButton.dataset.mobileMenuTarget, 'forward');
        });
      });
      window.addEventListener('resize', () => {
        if (!window.matchMedia('(max-width: 990px)').matches) setMobileMenuOpen(false);
      });

      const searchDrawer = document.querySelector('[data-site-header-search-drawer]');
      const searchDrawerPanel = searchDrawer?.querySelector('.site-header__search-drawer-panel');
      const searchDrawerBackdrop = searchDrawer?.querySelector('.site-header__search-drawer-backdrop');
      const searchPointerClose = searchDrawer?.querySelector('[data-site-header-search-pointer-close]');
      const searchInput = searchDrawer?.querySelector('#site-header-search-input');
      const searchToggles = [...header.querySelectorAll('[data-site-header-search-toggle]')];
      const searchTransitionDuration = 650;
      let searchDrawerOpen = false;
      let searchDrawerCloseTimer;
      let searchScrollLock;
      const isDesktopSearchDrawer = () => window.matchMedia('(min-width: 991px)').matches;
      const setSearchPointerCloseVisible = (isVisible) => {
        if (!searchDrawer) return;

        searchDrawer.classList.toggle('is-pointer-close-visible', Boolean(isVisible && searchDrawerOpen && isDesktopSearchDrawer()));
      };
      const resetSearchPointerClose = () => {
        setSearchPointerCloseVisible(false);
        searchPointerClose?.style.removeProperty('--site-header-search-cursor-x');
        searchPointerClose?.style.removeProperty('--site-header-search-cursor-y');
      };
      const updateSearchPointerClosePosition = (event) => {
