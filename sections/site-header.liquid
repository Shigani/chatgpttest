<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <button class="site-header__menu-toggle" type="button" data-site-header-mobile-toggle aria-label="{{ 'header.menu' | t }}" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-header__navigation" aria-label="{{ 'header.primary_navigation' | t }}">
      {% render 'site-header-demo-desktop-nav' %}
      {% comment %}
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            {% assign menu_handle = link.title | handleize %}
            {% assign has_promo_blocks = false %}
            {% for block in section.blocks %}
              {% if block.type == 'mega_menu_promo' %}
                {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                  {% if block.settings.image != blank %}
                    {% assign has_promo_blocks = true %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
            {% assign has_nested_links = false %}
            {% for child_link in link.links %}
              {% if child_link.links != blank %}
                {% assign has_nested_links = true %}
              {% endif %}
            {% endfor %}

            <details class="site-header__dropdown{% unless has_nested_links %} site-header__dropdown--simple{% endunless %}" data-site-header-dropdown data-action="hover">
              <summary class="site-header__dropdown-trigger" aria-controls="site-header-mega-{{ section.id }}-{{ forloop.index }}" aria-haspopup="true">
                <span>{{ link.title | escape }}</span>
                <svg class="site-header__dropdown-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="site-header__dropdown-panel{% if has_promo_blocks %} site-header__dropdown-panel--with-promos{% endif %}{% unless has_nested_links %} site-header__dropdown-panel--simple{% endunless %}" id="site-header-mega-{{ section.id }}-{{ forloop.index }}">
                <div class="site-header__mega-menu-inner">
                  <div class="site-header__mega-menu-links">
                    {% assign has_direct_links = false %}
                    {% for child_link in link.links %}
                      {% if child_link.links == blank %}
                        {% assign has_direct_links = true %}
                      {% endif %}
                    {% endfor %}

                    {% if has_direct_links %}
                      <div class="site-header__mega-menu-column site-header__mega-menu-column--direct">
                        <ul class="site-header__mega-menu-list" role="list">
                          {% for child_link in link.links %}
                            {% if child_link.links == blank %}
                              <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% for child_link in link.links %}
                      {% if child_link.links != blank %}
                        <div class="site-header__mega-menu-column">
                          <a class="site-header__mega-menu-title" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                          <ul class="site-header__mega-menu-list" role="list">
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if has_promo_blocks %}
                    <div class="site-header__mega-menu-promos">
                      {% for block in section.blocks %}
                        {% if block.type == 'mega_menu_promo' %}
                          {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                            {% if block.settings.image != blank %}
                              <a class="site-header__mega-menu-promo" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.root_url }}{% endif %}" {{ block.shopify_attributes }}>
                                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
                                <span class="site-header__mega-menu-promo-caption">
                                  <span>{{ block.settings.title | default: link.title | escape }}</span>
                                  <span aria-hidden="true">&#8599;</span>
                                </span>
                              </a>
                            {% endif %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.catalog' | t }}</a>
        <a href="/pages/contact">{{ 'header.contact' | t }}</a>
    {% endif %}
      {% endcomment %}
    </nav>

    <div class="site-header__mobile-menu" data-site-header-mobile-menu aria-hidden="true">
      <div class="site-header__mobile-menu-backdrop" data-site-header-mobile-close></div>
      <aside class="site-header__mobile-menu-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}">
        <div class="site-header__mobile-menu-screens" data-site-header-mobile-screens>
          {% render 'site-header-mobile-nav' %}
        </div>
      </aside>
    </div>

    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <details class="site-header__dropdown site-header__dropdown--simple site-header__localization-dropdown" data-site-header-dropdown data-action="hover">
        <summary class="site-header__localization site-header__dropdown-trigger" aria-controls="site-header-localization-{{ section.id }}" aria-haspopup="listbox" aria-label="Currency: CAD $">
          <span class="site-header__localization-value">
            <svg class="site-header__localization-flag" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="6" width="20" height="12" rx="1" fill="#ef233c"></rect>
              <rect x="8" y="6" width="8" height="12" fill="#ffffff"></rect>
              <path d="m12 7.1.75 2.15 2.2-.4-1.35 1.65 1.55 1.25-2.2-.18.1 2.25-1.05-1.5-1.05 1.5.1-2.25-2.2.18 1.55-1.25-1.35-1.65 2.2.4z" fill="#ef233c"></path>
            </svg>
            <span>CAD&nbsp;$</span>
          </span>
          <svg class="site-header__dropdown-chevron site-header__localization-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>

        <div class="site-header__dropdown-panel site-header__dropdown-panel--simple site-header__localization-panel" id="site-header-localization-{{ section.id }}">
          <div class="site-header__localization-search">
            <label class="visually-hidden" for="site-header-localization-search-{{ section.id }}">Search country</label>
            <input id="site-header-localization-search-{{ section.id }}" type="search" placeholder="Search" autocomplete="off" data-site-header-localization-search>
            <svg class="site-header__localization-search-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
          </div>

          <div class="site-header__localization-list" role="listbox" aria-label="Countries and currencies">
            {% comment %}
            {% assign site_header_countries = 'Australia|AUD|$|au,Belgium|EUR|€|be,Canada|CAD|$|ca,France|EUR|€|fr,Germany|EUR|€|de,Italy|EUR|€|it,Japan|JPY|¥|jp,Spain|EUR|€|es,United States|USD|$|us,Vietnam|VND|₫|vn' | split: ',' %}
            {% endcomment %}
            {% assign site_header_countries = 'Australia|AUD|$|au,Belgium|EUR|&euro;|be,Canada|CAD|$|ca,France|EUR|&euro;|fr,Germany|EUR|&euro;|de,Italy|EUR|&euro;|it,Japan|JPY|&yen;|jp,Spain|EUR|&euro;|es,United States|USD|$|us,Vietnam|VND|&#8363;|vn' | split: ',' %}
            {% for country in site_header_countries %}
              {% assign country_parts = country | split: '|' %}
              <button class="site-header__localization-option" type="button" role="option"{% if country_parts[0] == 'Canada' %} aria-current="true"{% endif %} data-site-header-localization-option data-country-search="{{ country | downcase | escape }}">
                <span class="site-header__country-flag" style="--country-flag: url('https://cdn.shopify.com/static/images/flags/{{ country_parts[3] }}.svg?width=20');" aria-hidden="true"></span>
                <span class="site-header__country-name">{{ country_parts[0] }}</span>
                <span class="site-header__country-currency">{{ country_parts[1] }}&nbsp;{{ country_parts[2] }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      </details>
      <span class="site-header__actions-divider" aria-hidden="true"></span>

      <a class="site-header__search" href="{{ routes.search_url }}" data-site-header-search-toggle aria-controls="site-header-search-drawer" aria-expanded="false">
        <span>{{ 'header.search_prompt' | t }}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M5 21a7 7 0 0 1 14 0"></path>
        </svg>
      </a>

      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg class="site-header__bag" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.5 8.5h13l-1 11h-11z"></path>
          <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<div class="site-header__search-drawer" id="site-header-search-drawer" data-site-header-search-drawer aria-hidden="true">
  <div class="site-header__search-drawer-backdrop" data-site-header-search-close></div>
  <button class="site-header__search-drawer-pointer-close" type="button" data-site-header-search-pointer-close aria-hidden="true" tabindex="-1">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4 20 20M20 4 4 20"></path>
    </svg>
  </button>
  <aside class="site-header__search-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="site-header-search-heading">
    <div class="site-header__search-drawer-header">
      <h2 id="site-header-search-heading">{{ 'header.search' | t }}</h2>
      <button class="site-header__search-drawer-close" type="button" data-site-header-search-close aria-label="{{ 'header.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4 20 20M20 4 4 20"></path>
        </svg>
      </button>
    </div>

    <div class="site-header__search-drawer-inner">
      <form class="site-header__search-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="site-header-search-input">{{ 'header.search' | t }}</label>
        <div class="site-header__search-input-wrap">
          <input id="site-header-search-input" name="q" type="search" placeholder="{{ 'header.search' | t }}" autocomplete="off">
          <button type="submit" aria-label="{{ 'header.search' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
          </button>
        </div>
      </form>

      <section class="site-header__popular-searches" aria-labelledby="site-header-popular-searches-heading">
        <h3 id="site-header-popular-searches-heading">{{ 'header.popular_searches' | t }}</h3>
        <div class="site-header__popular-search-list">
          <a href="{{ routes.search_url }}?q={{ 'header.running_shoes' | t | url_encode }}">{{ 'header.running_shoes' | t }}</a>
          <a href="{{ routes.search_url }}?q={{ 'header.trail_running_shoes' | t | url_encode }}">{{ 'header.trail_running_shoes' | t }}</a>
          <a href="{{ routes.search_url }}?q={{ 'header.hiking_shoes' | t | url_encode }}">{{ 'header.hiking_shoes' | t }}</a>
        </div>
      </section>
    </div>
  </aside>
</div>

<div class="site-header__mobile-currency-drawer" id="site-header-mobile-currency-drawer" data-site-header-mobile-currency-drawer aria-hidden="true">
  <div class="site-header__mobile-currency-backdrop" data-site-header-mobile-currency-close></div>
  <aside class="site-header__mobile-currency-panel" role="dialog" aria-modal="true" aria-labelledby="site-header-mobile-currency-heading">
    <div class="site-header__mobile-currency-grabber" aria-hidden="true"></div>
    <div class="site-header__mobile-currency-header">
      <h2 id="site-header-mobile-currency-heading">{{ 'header.country' | t }}</h2>
      <button class="site-header__mobile-currency-close" type="button" data-site-header-mobile-currency-close aria-label="{{ 'header.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4 20 20M20 4 4 20"></path>
        </svg>
      </button>
    </div>

    <div class="site-header__mobile-currency-search">
      <label class="visually-hidden" for="site-header-mobile-currency-search-{{ section.id }}">{{ 'header.search' | t }}</label>
      <input id="site-header-mobile-currency-search-{{ section.id }}" type="search" placeholder="{{ 'header.search' | t }}" autocomplete="off" data-site-header-mobile-currency-search>
      <svg class="site-header__mobile-currency-search-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </div>

    <div class="site-header__mobile-currency-list" role="listbox" aria-label="Countries and currencies">
      {% assign site_header_mobile_countries = 'Australia|AUD|$|au,Belgium|EUR|&euro;|be,Canada|CAD|$|ca,France|EUR|&euro;|fr,Germany|EUR|&euro;|de,Italy|EUR|&euro;|it,Japan|JPY|&yen;|jp,Spain|EUR|&euro;|es,United States|USD|$|us,Vietnam|VND|&#8363;|vn' | split: ',' %}
      {% for country in site_header_mobile_countries %}
        {% assign country_parts = country | split: '|' %}
        <button class="site-header__mobile-currency-option" type="button" role="option"{% if country_parts[0] == 'Canada' %} aria-current="true"{% endif %} data-site-header-mobile-currency-option data-country-search="{{ country | downcase | escape }}">
          <span class="site-header__mobile-currency-flag" style="--country-flag: url('https://cdn.shopify.com/static/images/flags/{{ country_parts[3] }}.svg?width=20');" aria-hidden="true"></span>
          <span class="site-header__mobile-currency-name">{{ country_parts[0] }}</span>
          <span class="site-header__mobile-currency-value">{{ country_parts[1] }}&nbsp;{{ country_parts[2] }}</span>
        </button>
      {% endfor %}
    </div>
  </aside>
</div>

{% stylesheet %}
  html {
    scrollbar-gutter: stable;
  }

  .site-header {
    --site-header-top: clamp(0.75rem, 2.5vh, 1.5rem);
    position: fixed;
    top: var(--site-header-top);
    right: 3.125rem;
    left: 3.125rem;
    z-index: 20;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.site-header-dropdown-active,
  html.site-header-dropdown-active body {
    overflow: hidden;
  }

  html.site-header-mobile-menu-open,
  html.site-header-mobile-menu-open body {
    overflow: hidden;
  }

  html.site-header-search-open,
  html.site-header-search-open body {
    overflow: hidden;
  }

  html.site-header-mobile-currency-open,
  html.site-header-mobile-currency-open body {
    overflow: hidden;
  }

  #MainContent {
    transition: filter 220ms ease;
  }

  body.site-header-dropdown-active #MainContent {
    filter: blur(0.35rem);
    pointer-events: none;
  }

  body.site-header-search-open #MainContent {
    filter: blur(0.35rem);
    pointer-events: none;
  }

  body.site-header-mobile-currency-open #MainContent {
    filter: blur(0.35rem);
    pointer-events: none;
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 5rem;
    padding: 0 clamp(1rem, 2.5vw, 1.95rem);
    border: 1px solid rgb(11 11 11 / 0.06);
    border-radius: 1rem;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.08);
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 350ms ease, border-color 350ms ease, box-shadow 350ms ease, color 350ms ease, border-bottom-left-radius 300ms cubic-bezier(0.22, 1, 0.36, 1), border-bottom-right-radius 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    padding-inline: 0;
  }

  .site-header:not(.site-header--scrolled) {
    --site-header-top: 0;
    top: 0;
    right: 0;
    left: 0;
    background: #ffffff;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    margin-inline: 3.125rem;
    border-color: transparent;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
  }

  .template-index .site-header:not(.site-header--scrolled) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled)::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: -1;
    height: 5rem;
    background: #ffffff;
    content: '';
    pointer-events: none;
    transform: translateY(-100%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open])::before {
    transform: translateY(0);
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open] .site-header__dropdown-panel--closing)::before {
    transform: translateY(-100%);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
    background: transparent;
    color: #ffffff;
    box-shadow: none;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) {
    background: #ffffff;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) .site-header__bar {
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open] .site-header__dropdown-panel--closing) .site-header__bar {
    color: #ffffff;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open]) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open]) .site-header__bar {
    background: transparent;
    color: #0b0b0b;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open] .site-header__dropdown-panel--closing) .site-header__bar {
    background: transparent;
    color: #ffffff;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled).site-header--dropdown-handoff:has(.site-header__dropdown--simple[open]) {
    background: #ffffff;
  }

  .template-index .site-header:not(.site-header--scrolled).site-header--dropdown-handoff:has(.site-header__dropdown--simple[open]) .site-header__bar {
    background: #ffffff;
    color: #0b0b0b;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown:not(.site-header__dropdown--simple).site-header__dropdown--closing):not(.site-header--dropdown-handoff) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown:not(.site-header__dropdown--simple).site-header__dropdown--closing):not(.site-header--dropdown-handoff) .site-header__bar {
    background: transparent;
    color: #ffffff;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .site-header__navigation,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__navigation {
    justify-self: start;
    gap: clamp(1.35rem, 2.15vw, 2rem);
  }

  .site-header__actions {
    justify-self: end;
    gap: 0.65rem;
  }

  .site-header__menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__mobile-menu {
    display: none;
  }

  .site-header__mobile-currency-drawer {
    display: none;
  }

  .site-header__search-drawer {
    --site-header-search-transition-duration: 650ms;
    --site-header-search-transition-easing: cubic-bezier(0.22, 1, 0.36, 1);
    position: fixed;
    inset: 0;
    z-index: 40;
    display: block;
    padding: 1rem;
    overflow: hidden;
    background: transparent;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear var(--site-header-search-transition-duration);
  }

  .site-header__search-drawer.is-open,
  .site-header__search-drawer.is-closing {
    visibility: visible;
  }

  .site-header__search-drawer.is-open {
    pointer-events: auto;
    transition: visibility 0s;
  }

  .site-header__search-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(50 50 50 / 50%);
    backdrop-filter: blur(0.18rem);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .site-header__search-drawer.is-open .site-header__search-drawer-backdrop {
    opacity: 1;
