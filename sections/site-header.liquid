{% javascript %}
  const initializeSiteHeaders = (root = document) => {
    root.querySelectorAll('[data-site-header]').forEach((header) => {
      if (header.dataset.siteHeaderInitialized === 'true') return;

      header.querySelectorAll('a[href]').forEach((link) => {
        link.removeAttribute('href');
      });

      let lastScrollY = window.scrollY;
      const positionSimpleDropdowns = () => {
        const isMobile = window.matchMedia('(max-width: 990px)').matches;
        const headerBottom = header.getBoundingClientRect().bottom;

        header.querySelectorAll('.site-header__dropdown--simple > .site-header__dropdown-panel--simple').forEach((panel) => {
          if (isMobile) {
            panel.style.removeProperty('top');
            return;
          }

          const dropdownTop = panel.parentElement?.getBoundingClientRect().top ?? 0;
          panel.style.top = `${Math.max(0, headerBottom - dropdownTop)}px`;
        });
      };

      const updateHeader = () => {
        const currentScrollY = Math.max(window.scrollY, 0);
        const isScrolled = currentScrollY > 12;
        const isMobile = window.matchMedia('(max-width: 990px)').matches;

        header.classList.toggle('site-header--scrolled', isScrolled);

        if (!isMobile) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY <= 24 || currentScrollY < lastScrollY - 2) {
          header.classList.remove('site-header--hidden');
        } else if (currentScrollY > lastScrollY + 2 && currentScrollY > 80) {
          header.classList.add('site-header--hidden');
        }

        positionSimpleDropdowns();
        lastScrollY = currentScrollY;
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
      window.addEventListener('resize', updateHeader);

      const dropdowns = [...header.querySelectorAll('[data-site-header-dropdown]')];
      let dropdownScrollLock;
      const updateDropdownScrollLock = (isActive) => {
        if (isActive) {
          if (dropdownScrollLock) return;

          const scrollY = window.scrollY;

          dropdownScrollLock = { scrollY };

          window.scrollTo(0, scrollY);
          return;
        }

        if (!dropdownScrollLock) return;

        const { scrollY } = dropdownScrollLock;
        window.scrollTo(0, scrollY);
        dropdownScrollLock = null;
      };
      const dropdownPanelHeights = new WeakMap();
      const getPanelNaturalHeight = (panel) => {
        if (!panel) return 0;

        const computedStyle = window.getComputedStyle(panel);
        const borderHeight = (Number.parseFloat(computedStyle.borderTopWidth) || 0)
          + (Number.parseFloat(computedStyle.borderBottomWidth) || 0);
        const innerHeight = panel.querySelector('.site-header__mega-menu-inner')?.getBoundingClientRect().height ?? 0;

        return Math.max(panel.scrollHeight + borderHeight, innerHeight + borderHeight);
      };
      const syncDropdownState = () => {
        const isDropdownActive = dropdowns.some((dropdown) => dropdown.open);

        dropdowns.forEach((dropdown) => {
          if (!dropdown.open) return;

          const panel = dropdown.querySelector('.site-header__dropdown-panel');
          if (panel?.style.height) return;
          const panelHeight = getPanelNaturalHeight(panel);
          if (panelHeight > 0) dropdownPanelHeights.set(dropdown, panelHeight);
        });

        updateDropdownScrollLock(isDropdownActive);
        document.documentElement.classList.toggle('site-header-dropdown-active', isDropdownActive);
        document.body?.classList.toggle('site-header-dropdown-active', isDropdownActive);

        if (isDropdownActive && dropdownScrollLock) {
          window.scrollTo(0, dropdownScrollLock.scrollY);
        }
      };
      const closingAnimationHandlers = new WeakMap();
      const switchHeightAnimationHandlers = new WeakMap();
      const cancelClosingAnimation = (panel) => {
        const handler = closingAnimationHandlers.get(panel);
        if (handler) {
          panel.removeEventListener('animationend', handler);
          closingAnimationHandlers.delete(panel);
        }

        panel.classList.remove('site-header__dropdown-panel--closing');
        panel.closest('[data-site-header-dropdown]')?.classList.remove('site-header__dropdown--closing');
      };
      const cancelSwitchHeightAnimation = (panel) => {
        const animation = switchHeightAnimationHandlers.get(panel);
        if (animation) {
          if (animation.finish) panel.removeEventListener('transitionend', animation.finish);
          if (animation.frameId) window.clearTimeout(animation.frameId);
          window.clearTimeout(animation.timer);
          switchHeightAnimationHandlers.delete(panel);
        }

        panel.classList.remove('site-header__dropdown-panel--switch-height');
        panel.style.removeProperty('height');
      };
      const resetDropdownAnimation = (dropdown) => {
        const panel = dropdown.querySelector('.site-header__dropdown-panel');
        if (!panel) return;

        panel.classList.remove('site-header__dropdown-panel--replay');
        panel.classList.remove('site-header__dropdown-panel--content-replay');
        panel.classList.remove('site-header__dropdown-panel--instant');
        cancelSwitchHeightAnimation(panel);
        cancelClosingAnimation(panel);
      };
      const closeDropdown = (dropdown) => {
        const panel = dropdown.querySelector('.site-header__dropdown-panel');
        if (!dropdown.open || !panel || panel.classList.contains('site-header__dropdown-panel--closing')) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          dropdown.removeAttribute('open');
          dropdown.classList.remove('site-header__dropdown--underline-closing');
          header.classList.remove('site-header--dropdown-handoff');
          syncDropdownState();
          return;
        }

        resetDropdownAnimation(dropdown);
        void panel.offsetWidth;
        const finishClosing = () => {
          closingAnimationHandlers.delete(panel);
          dropdown.removeAttribute('open');
          dropdown.classList.remove('site-header__dropdown--closing');
          dropdown.classList.remove('site-header__dropdown--underline-closing');
          panel.classList.remove('site-header__dropdown-panel--closing');
          if (!header.querySelector('.site-header__dropdown--closing')) {
            header.classList.remove('site-header--dropdown-handoff');
          }
          syncDropdownState();
        };

        closingAnimationHandlers.set(panel, finishClosing);
        panel.addEventListener('animationend', finishClosing, { once: true });
        dropdown.classList.add('site-header__dropdown--closing');
        panel.classList.add('site-header__dropdown-panel--closing');
      };
      const closeDropdowns = (except = null) => {
        dropdowns.forEach((dropdown) => {
          if (dropdown !== except) {
            closeDropdown(dropdown);
          }
        });
      };
      const mobileMenu = header.querySelector('[data-site-header-mobile-menu]');
      const mobileMenuToggle = header.querySelector('[data-site-header-mobile-toggle]');
      const mobileMenuCloseButton = mobileMenu?.querySelector('[data-site-header-mobile-close][type="button"]');
      const mobileMenuScreens = Array.from(mobileMenu?.querySelectorAll('[data-site-header-mobile-screen]') ?? []);
      const mobileMenuViews = Array.from(mobileMenu?.querySelectorAll('[data-site-header-mobile-view]') ?? []);
      const mobileMenuTransitionDuration = 650;
      let mobileMenuOpen = false;
      let mobileMenuCloseTimer;
      let mobileMenuViewCleanupTimer;
      let mobileMenuScrollLock;
      const getMobileMenuScreen = (view) => view?.closest('[data-site-header-mobile-screen]');
      const setMobileMenuScreenVisibility = (screen, isVisible) => {
        if (!screen) return;

        screen.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
        screen.querySelector('[data-site-header-mobile-view]')?.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
      };
      const resetMobileMenuView = () => {
        window.clearTimeout(mobileMenuViewCleanupTimer);
        mobileMenuScreens.forEach((screen) => {
          const isRoot = screen.dataset.siteHeaderMobileScreen === 'root';
          screen.classList.toggle('is-active', isRoot);
          screen.classList.remove('is-before', 'is-after', 'is-hidden', 'is-underlay', 'is-screen-return-prep');
          screen.classList.toggle('is-hidden', !isRoot);
          setMobileMenuScreenVisibility(screen, isRoot);
          if (isRoot) screen.querySelector('[data-site-header-mobile-view]')?.scrollTo(0, 0);
        });
      };
      const setMobileMenuView = (targetId, direction = 'forward') => {
        const targetView = mobileMenuViews.find((view) => view.dataset.siteHeaderMobileView === targetId);
        const targetScreen = getMobileMenuScreen(targetView);
        const currentScreen = mobileMenuScreens.find((screen) => screen.classList.contains('is-active'));
        if (!targetView || !targetScreen || targetScreen === currentScreen) return;

        window.clearTimeout(mobileMenuViewCleanupTimer);

        if (currentScreen) {
          if (direction === 'forward') {
            currentScreen.classList.remove('is-active', 'is-before', 'is-after', 'is-hidden', 'is-screen-return-prep');
            currentScreen.classList.add('is-underlay');
          } else {
            currentScreen.classList.remove('is-active', 'is-before', 'is-after', 'is-hidden', 'is-underlay');
            currentScreen.classList.add('is-screen-return-prep');
          }
          setMobileMenuScreenVisibility(currentScreen, false);
        }

        if (direction === 'forward') {
          mobileMenuScreens.forEach((screen) => {
            if (screen === currentScreen || screen === targetScreen) return;
            screen.classList.remove('is-before', 'is-after', 'is-active', 'is-underlay', 'is-screen-return-prep');
            screen.classList.add('is-hidden');
            setMobileMenuScreenVisibility(screen, false);
          });
        }

        targetScreen.classList.remove('is-before', 'is-after', 'is-hidden', 'is-underlay', 'is-screen-return-prep');
        if (direction === 'back') {
          targetScreen.classList.add('is-underlay');
        } else {
          targetScreen.classList.add('is-active');
        }
        targetView.scrollTop = 0;
        setMobileMenuScreenVisibility(targetScreen, direction !== 'back');
        if (direction === 'back') {
          if (currentScreen) {
            void currentScreen.offsetWidth;
            currentScreen.classList.remove('is-screen-return-prep');
            currentScreen.classList.add('is-after');
          }
        }

        mobileMenuViewCleanupTimer = window.setTimeout(() => {
          mobileMenuScreens.forEach((screen) => {
            if (screen === targetScreen) {
              screen.classList.remove('is-before', 'is-after', 'is-hidden', 'is-underlay', 'is-screen-return-prep');
              screen.classList.add('is-active');
              setMobileMenuScreenVisibility(screen, true);
              return;
            }
            screen.classList.remove('is-before', 'is-after', 'is-active', 'is-underlay', 'is-screen-return-prep');
            screen.classList.add('is-hidden');
            setMobileMenuScreenVisibility(screen, false);
          });
        }, mobileMenuTransitionDuration + 20);
      };
      const updateMobileMenuScrollLock = (isActive) => {
        if (isActive) {
          if (mobileMenuScrollLock) return;

          const scrollY = window.scrollY;

          mobileMenuScrollLock = { scrollY };
          document.documentElement.classList.add('site-header-mobile-menu-open');

          window.scrollTo(0, scrollY);
          return;
        }

        if (!mobileMenuScrollLock) return;

        const { scrollY } = mobileMenuScrollLock;
        document.documentElement.classList.remove('site-header-mobile-menu-open');
        window.scrollTo(0, scrollY);
        mobileMenuScrollLock = null;
      };
      const setMobileMenuOpen = (isOpen) => {
        if (!mobileMenu || !mobileMenuToggle) return;

        window.clearTimeout(mobileMenuCloseTimer);

        if (isOpen) {
          resetMobileMenuView();
          closeDropdowns();
          syncDropdownState();
          mobileMenuOpen = true;
          header.classList.add('site-header--menu-open');
          mobileMenu.classList.remove('is-closing');
          mobileMenu.classList.add('is-open');
          mobileMenu.setAttribute('aria-hidden', 'false');
          mobileMenuToggle.setAttribute('aria-expanded', 'true');
          updateMobileMenuScrollLock(true);
          window.requestAnimationFrame(() => {
            if (mobileMenuOpen) mobileMenuCloseButton?.focus();
