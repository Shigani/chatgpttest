<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <button class="site-header__menu-toggle" type="button" data-site-header-mobile-toggle aria-label="{{ 'header.menu' | t }}" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="site-header__navigation" aria-label="{{ 'header.primary_navigation' | t }}">
      {% render 'site-header-demo-desktop-nav' %}
      {% comment %}
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            {% assign menu_handle = link.title | handleize %}
            {% assign has_promo_blocks = false %}
            {% for block in section.blocks %}
              {% if block.type == 'mega_menu_promo' %}
                {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                  {% if block.settings.image != blank %}
                    {% assign has_promo_blocks = true %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
            {% assign has_nested_links = false %}
            {% for child_link in link.links %}
              {% if child_link.links != blank %}
                {% assign has_nested_links = true %}
              {% endif %}
            {% endfor %}

            <details class="site-header__dropdown{% unless has_nested_links %} site-header__dropdown--simple{% endunless %}" data-site-header-dropdown data-action="hover">
              <summary class="site-header__dropdown-trigger" aria-controls="site-header-mega-{{ section.id }}-{{ forloop.index }}" aria-haspopup="true">
                <span>{{ link.title | escape }}</span>
                <svg class="site-header__dropdown-chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="site-header__dropdown-panel{% if has_promo_blocks %} site-header__dropdown-panel--with-promos{% endif %}{% unless has_nested_links %} site-header__dropdown-panel--simple{% endunless %}" id="site-header-mega-{{ section.id }}-{{ forloop.index }}">
                <div class="site-header__mega-menu-inner">
                  <div class="site-header__mega-menu-links">
                    {% assign has_direct_links = false %}
                    {% for child_link in link.links %}
                      {% if child_link.links == blank %}
                        {% assign has_direct_links = true %}
                      {% endif %}
                    {% endfor %}

                    {% if has_direct_links %}
                      <div class="site-header__mega-menu-column site-header__mega-menu-column--direct">
                        <ul class="site-header__mega-menu-list" role="list">
                          {% for child_link in link.links %}
                            {% if child_link.links == blank %}
                              <li><a href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% for child_link in link.links %}
                      {% if child_link.links != blank %}
                        <div class="site-header__mega-menu-column">
                          <a class="site-header__mega-menu-title" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                          <ul class="site-header__mega-menu-list" role="list">
                            {% for grandchild_link in child_link.links %}
                              <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if has_promo_blocks %}
                    <div class="site-header__mega-menu-promos">
                      {% for block in section.blocks %}
                        {% if block.type == 'mega_menu_promo' %}
                          {% if block.settings.menu_item == menu_handle or block.settings.menu_item == link.handle %}
                            {% if block.settings.image != blank %}
                              <a class="site-header__mega-menu-promo" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.root_url }}{% endif %}" {{ block.shopify_attributes }}>
                                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
                                <span class="site-header__mega-menu-promo-caption">
                                  <span>{{ block.settings.title | default: link.title | escape }}</span>
                                  <span aria-hidden="true">&#8599;</span>
                                </span>
                              </a>
                            {% endif %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'header.catalog' | t }}</a>
        <a href="/pages/contact">{{ 'header.contact' | t }}</a>
    {% endif %}
      {% endcomment %}
    </nav>

    <div class="site-header__mobile-menu" data-site-header-mobile-menu aria-hidden="true">
      <div class="site-header__mobile-menu-backdrop" data-site-header-mobile-close></div>
      <aside class="site-header__mobile-menu-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}">
        <div class="site-header__mobile-menu-screens" data-site-header-mobile-screens>
          {% render 'site-header-mobile-nav' %}
        </div>

        <div class="site-header__mobile-menu-footer">
          <a class="site-header__mobile-menu-account" href="{{ routes.account_url }}">{{ 'header.account' | t }}</a>
          <div class="site-header__mobile-menu-utilities">
            <a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a>
            <a href="{{ routes.cart_url }}">{{ 'header.cart' | t }}</a>
          </div>
        </div>
      </aside>
    </div>

    <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

    <div class="site-header__actions">
      <a class="site-header__search" href="{{ routes.search_url }}">
        <span>{{ 'header.search_prompt' | t }}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M5 21a7 7 0 0 1 14 0"></path>
        </svg>
      </a>

      <a class="site-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.2 10h10.9l2-7H7"></path>
          <circle cx="9" cy="19" r="1"></circle>
          <circle cx="18" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    --site-header-top: clamp(0.75rem, 2.5vh, 1.5rem);
    position: fixed;
    top: var(--site-header-top);
    right: 3.125rem;
    left: 3.125rem;
    z-index: 20;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.site-header-dropdown-active,
  html.site-header-dropdown-active body {
    overflow: hidden;
  }

  html.site-header-mobile-menu-open,
  html.site-header-mobile-menu-open body {
    overflow: hidden;
  }

  #MainContent {
    transition: filter 220ms ease;
  }

  body.site-header-dropdown-active #MainContent {
    filter: blur(0.35rem);
    pointer-events: none;
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 5rem;
    padding: 0 clamp(1rem, 2.5vw, 1.95rem);
    border: 1px solid rgb(11 11 11 / 0.06);
    border-radius: 1rem;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.08);
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 350ms ease, border-color 350ms ease, box-shadow 350ms ease, color 350ms ease;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    padding-inline: 0;
  }

  .site-header:not(.site-header--scrolled) {
    --site-header-top: 0;
    top: 0;
    right: 0;
    left: 0;
    background: #ffffff;
  }

  .site-header:not(.site-header--scrolled) .site-header__bar {
    margin-inline: 3.125rem;
    border-color: transparent;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
  }

  .template-index .site-header:not(.site-header--scrolled) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled)::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: -1;
    height: 5rem;
    background: #ffffff;
    content: '';
    pointer-events: none;
    transform: translateY(-100%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open])::before {
    transform: translateY(0);
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open] .site-header__dropdown-panel--closing)::before {
    transform: translateY(-100%);
  }

  .template-index .site-header:not(.site-header--scrolled) .site-header__bar {
    background: transparent;
    color: #ffffff;
    box-shadow: none;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) {
    background: #ffffff;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open]) .site-header__bar {
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: none;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown[open] .site-header__dropdown-panel--closing) .site-header__bar {
    color: #ffffff;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open]) {
    background: transparent;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open]) .site-header__bar {
    background: transparent;
    color: #0b0b0b;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled):has(.site-header__dropdown--simple[open] .site-header__dropdown-panel--closing) .site-header__bar {
    background: transparent;
    color: #ffffff;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .template-index .site-header:not(.site-header--scrolled).site-header--dropdown-handoff:has(.site-header__dropdown--simple[open]) {
    background: #ffffff;
  }

  .template-index .site-header:not(.site-header--scrolled).site-header--dropdown-handoff:has(.site-header__dropdown--simple[open]) .site-header__bar {
    background: #ffffff;
    color: #0b0b0b;
    transition: padding-left 420ms cubic-bezier(0.22, 1, 0.36, 1), padding-right 420ms cubic-bezier(0.22, 1, 0.36, 1), background-color 0s, border-color 350ms ease, box-shadow 350ms ease, color 0s;
  }

  .site-header__navigation,
  .site-header__actions {
    display: flex;
    align-items: center;
  }

  .site-header__navigation {
    justify-self: start;
    gap: clamp(1.35rem, 2.15vw, 2rem);
  }

  .site-header__actions {
    justify-self: end;
    gap: 1.2rem;
  }

  .site-header__menu-toggle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__mobile-menu {
    display: none;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header__navigation a {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-header__navigation > a {
    position: relative;
  }

  .site-header__navigation > a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .site-header__navigation > a:hover::after,
  .site-header__navigation > a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__dropdown {
    position: static;
  }

  .site-header__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0;
    color: inherit;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    list-style: none;
  }

  .site-header__dropdown-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__dropdown-trigger::marker {
    content: '';
  }

  .site-header__dropdown-trigger > span:first-child {
    position: relative;
  }

  .site-header__dropdown-trigger > span:first-child::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .site-header__dropdown:not(.site-header__dropdown--closing):hover > .site-header__dropdown-trigger > span:first-child::after,
  .site-header__dropdown[open]:not(.site-header__dropdown--closing) > .site-header__dropdown-trigger > span:first-child::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__dropdown-chevron {
    width: 1.1rem;
    height: 1.1rem;
    transform-style: preserve-3d;
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__dropdown[open] > .site-header__dropdown-trigger .site-header__dropdown-chevron {
    transform: rotateX(180deg);
  }

  .site-header__dropdown-panel {
    position: absolute;
    top: 5rem;
    right: 0;
    left: 0;
    z-index: 1;
    padding: 0;
    border-top: 1px solid rgb(11 11 11 / 0.08);
    border-bottom: 1px solid rgb(11 11 11 / 0.08);
    border-radius: 0;
    background: #ffffff;
    color: #0b0b0b;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.08);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    visibility: hidden;
  }

  .site-header__dropdown[open] > .site-header__dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .site-header.site-header--scrolled:has(.site-header__dropdown[open]) .site-header__bar {
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }

  .site-header.site-header--scrolled .site-header__dropdown[open] > .site-header__dropdown-panel {
    overflow: hidden;
    border-bottom-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
  }

  .site-header.site-header--scrolled .site-header__dropdown-panel {
    top: 5rem;
    opacity: 1;
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 300ms;
  }

  .site-header.site-header--scrolled .site-header__dropdown[open] > .site-header__dropdown-panel {
    transform: scaleY(1);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear;
  }

  .site-header.site-header--scrolled .site-header__dropdown-panel--replay {
    animation: site-header-dropdown-slide-down-scrolled 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__dropdown-panel--instant {
    animation: none !important;
    transition: none !important;
  }

  .site-header__dropdown-panel--switch-height {
    transition: height 300ms cubic-bezier(0.22, 1, 0.36, 1) !important;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-column,
  .site-header__dropdown-panel--replay .site-header__mega-menu-promo,
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-column,
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-promo {
    animation: site-header-dropdown-item-fade-up 300ms cubic-bezier(0.22, 1, 0.36, 1) 300ms both;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-column:nth-child(2),
  .site-header__dropdown-panel--replay .site-header__mega-menu-promo:nth-child(2),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-column:nth-child(2),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-promo:nth-child(2) {
    animation-delay: 340ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-column:nth-child(3),
  .site-header__dropdown-panel--replay .site-header__mega-menu-promo:nth-child(3),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-column:nth-child(3),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-promo:nth-child(3) {
    animation-delay: 380ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(1),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(1) {
    animation-delay: 300ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(2),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(2) {
    animation-delay: 340ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(3),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-links--women .site-header__mega-menu-column:nth-child(3) {
    animation-delay: 380ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-promos--women .site-header__mega-menu-promo:nth-child(1),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-promos--women .site-header__mega-menu-promo:nth-child(1) {
    animation-delay: 420ms;
  }

  .site-header__dropdown-panel--replay .site-header__mega-menu-promos--women .site-header__mega-menu-promo:nth-child(2),
  .site-header__dropdown-panel--content-replay .site-header__mega-menu-promos--women .site-header__mega-menu-promo:nth-child(2) {
    animation-delay: 460ms;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(1),
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(1) {
    animation-delay: 300ms;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(2),
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(2) {
    animation-delay: 340ms;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(3),
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-links--men .site-header__mega-menu-column:nth-child(3) {
    animation-delay: 380ms;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-deals .site-header__mega-menu-product-card,
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-deals .site-header__mega-menu-product-card {
    animation: site-header-dropdown-item-fade-up 300ms cubic-bezier(0.22, 1, 0.36, 1) 420ms both;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-deals .site-header__mega-menu-product-card:nth-child(2),
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-deals .site-header__mega-menu-product-card:nth-child(2) {
    animation-delay: 460ms;
  }

  #site-header-demo-men.site-header__dropdown-panel--replay .site-header__mega-menu-deals .site-header__mega-menu-product-card:nth-child(3),
  #site-header-demo-men.site-header__dropdown-panel--content-replay .site-header__mega-menu-deals .site-header__mega-menu-product-card:nth-child(3) {
    animation-delay: 500ms;
  }

  .site-header.site-header--scrolled .site-header__dropdown-panel--closing {
    visibility: visible;
    opacity: 1;
    pointer-events: none;
    border-bottom-right-radius: 1rem;
    border-bottom-left-radius: 1rem;
    transition: none;
    animation: site-header-dropdown-slide-up-scrolled 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .site-header:not(.site-header--scrolled) .site-header__dropdown-panel {
    top: 0;
    z-index: -1;
    padding-top: 5rem;
    overflow: hidden;
    border-top: 0;
    opacity: 1;
    transform: translateY(-100%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 300ms;
  }

  .site-header:not(.site-header--scrolled) .site-header__dropdown[open] > .site-header__dropdown-panel {
    transform: translateY(0);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear;
  }

  .site-header:not(.site-header--scrolled) .site-header__dropdown-panel--replay {
    animation: site-header-dropdown-slide-down 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header:not(.site-header--scrolled) .site-header__dropdown-panel--closing {
    visibility: visible;
    opacity: 1;
    pointer-events: none;
    transition: none;
    animation: site-header-dropdown-slide-up 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

