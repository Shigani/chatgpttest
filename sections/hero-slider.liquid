{% assign theme_slide_count = section.blocks | where: 'type', '_hero-slide' | size %}
{% assign legacy_slide_count = section.blocks | where: 'type', 'slide' | size %}

<section
  class="hero-slider hero-slider--height-{{ section.settings.height }} hero-slider--container-{{ section.settings.container }} hero-slider--content-{{ section.settings.content_position }}{% if section.settings.header_overlay %} hero-slider--header-overlay{% endif %}{% if section.settings.allow_next_overlap %} hero-slider--overlap-next{% endif %}"
  data-hero-slider
  data-slide-count="{% if theme_slide_count > 0 %}{{ theme_slide_count }}{% else %}{{ legacy_slide_count }}{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
>
  <div class="swiper hero-slider__swiper">
    <div class="swiper-wrapper">
      {% if theme_slide_count > 0 %}
        {% content_for 'blocks' %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <article class="swiper-slide hero-slider__slide" {{ block.shopify_attributes }}>
              <div class="hero-slider__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slider__image', loading: 'lazy', sizes: '100vw' }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__placeholder' }}
                {% endif %}
              </div>

              <div class="hero-slider__overlay"></div>

              <div class="hero-slider__content hero-slider__content--{{ block.settings.alignment }}">
                {% if block.settings.eyebrow != blank %}
                  <p class="hero-slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <div class="hero-slider__heading" role="heading" aria-level="2">{{ block.settings.heading }}</div>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <a
                    class="hero-slider__button"
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                  >
                    <span class="hero-slider__button-label">{{ block.settings.button_label | escape }}</span>
                    <span class="hero-slider__button-icon" aria-hidden="true">
                      <span class="hero-slider__button-icon-label">{{ block.settings.button_label | escape }}</span>
                      <span class="hero-slider__button-icon-circle">
                        <svg viewBox="0 0 20 20" role="presentation">
                          <path d="m7 5 5 5-5 5"></path>
                        </svg>
                      </span>
                    </span>
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if theme_slide_count > 1 or legacy_slide_count > 1 %}
      <div class="hero-slider__controls hero-slider__controls--{{ section.settings.control_alignment }}">
        <div class="hero-slider__fraction" aria-live="polite">
          <span data-hero-current>1</span>
          <span aria-hidden="true">/</span>
          <span data-hero-total>{% if theme_slide_count > 0 %}{{ theme_slide_count }}{% else %}{{ legacy_slide_count }}{% endif %}</span>
        </div>

        <div class="hero-slider__progress" aria-hidden="true">
          <span data-hero-progress></span>
        </div>

        <button class="hero-slider__arrow hero-slider__arrow--previous" type="button" aria-label="{{ 'buttons.previous_slide' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="m12 4-6 6 6 6"></path>
          </svg>
        </button>

        <button class="hero-slider__arrow hero-slider__arrow--next" type="button" aria-label="{{ 'buttons.next_slide' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="m8 4 6 6-6 6"></path>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero-slider {
    position: relative;
    min-height: min(var(--hero-height), 100svh);
    overflow: hidden;
    background: #c6c6c6;
    color: #ffffff;
  }

  .hero-slider--height-adapt {
    --hero-height: 56.25vw;
  }

  .hero-slider--height-small {
    --hero-height: 32rem;
  }

  .hero-slider--height-medium {
    --hero-height: 44rem;
  }

  .hero-slider--height-large {
    --hero-height: 56rem;
  }

  .hero-slider--container-fixed .hero-slider__swiper {
    max-width: 90rem;
    margin: 0 auto;
  }

  .hero-slider--overlap-next {
    z-index: 1;
    margin-bottom: -4rem;
  }

  .hero-slider__swiper,
  .hero-slider__slide {
    min-height: min(var(--hero-height), 100svh);
  }

  .hero-slider__swiper {
    position: relative;
    width: 100%;
    overflow: hidden !important;
  }

  .hero-slider__swiper .swiper-wrapper {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .hero-slider__slide {
    position: relative;
    display: grid;
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100%;
    max-width: 100%;
    isolation: isolate;
  }

  .hero-slider__media,
  .hero-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .hero-slider__media {
    z-index: -2;
  }

  .hero-slider__image,
  .hero-slider__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }

  .hero-slider__placeholder {
    background: #c6c6c6;
    color: #676767;
  }

  .hero-slider__overlay {
    z-index: -1;
    background: linear-gradient(90deg, rgb(118 118 118 / 0.24), transparent 58%);
  }

  .hero-slider__content {
    align-self: start;
    width: min(100%, 31rem);
    padding: clamp(12.5rem, 30vh, 14.5rem) clamp(2rem, 3.9vw, 3.15rem) 5rem;
  }

  .hero-slider__content--center {
    justify-self: center;
    text-align: center;
  }

  .hero-slider__content--right {
    justify-self: end;
    text-align: right;
  }

  .hero-slider__eyebrow {
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    will-change: opacity, transform;
  }

  .hero-slider__heading {
    margin: 0;
    font-size: clamp(3.5rem, 5.1vw, 4.2rem);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.2;
    text-wrap: balance;
    will-change: opacity, transform;
  }

  .hero-slider__heading p {
    margin: 0;
  }

  .hero-slider__eyebrow p {
    margin: 0;
  }

  .hero-slider__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    min-width: 11.8rem;
    height: 3.125rem;
    margin-top: 1.85rem;
    padding: 0 0.625rem 0 1.5rem;
    border-radius: 60px;
    background: rgb(255 255 255 / 0.72);
    color: #5d5d5d;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
    will-change: opacity, transform;
  }

  .hero-slider__slide.swiper-slide-active .hero-slider__eyebrow,
  .hero-slider__slide.swiper-slide-active .hero-slider__heading,
  .hero-slider__slide.swiper-slide-active .hero-slider__button {
    animation: hero-slider-content-fade-up 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-slider__slide.swiper-slide-active .hero-slider__heading {
    animation-delay: 120ms;
  }

  .hero-slider__slide.swiper-slide-active .hero-slider__button {
    animation-delay: 220ms;
  }

  .hero-slider__button:hover {
    transform: translateY(-2px);
    background: #ffffff;
  }

  .hero-slider__button[aria-disabled="true"] {
    cursor: default;
  }

  .hero-slider__button-label,
  .hero-slider__button-icon-label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hero-slider__button-icon {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    gap: 0.65rem;
    padding: 0 0.625rem 0 1.5rem;
    overflow: hidden;
    clip-path: circle(0.9375rem at calc(100% - 0.9375rem - 0.625rem) 50%);
    background: #666666;
    color: #ffffff;
    transition: clip-path 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-slider__button-icon-circle {
    display: grid;
    width: 1.875rem;
    height: 1.875rem;
    flex-shrink: 0;
    border-radius: 50%;
    place-items: center;
  }

  .hero-slider__button-icon-circle svg,
  .hero-slider__arrow svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-slider__button:hover .hero-slider__button-icon {
      clip-path: circle(150% at calc(100% - 0.9375rem - 0.625rem) 50%);
    }

    .hero-slider__button:hover .hero-slider__button-icon-circle svg {
      animation: hero-slider-slide-in-out 900ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes hero-slider-slide-in-out {
    0% { transform: translateX(0); }
    50% { transform: translateX(2rem); }
    50.001% { transform: translateX(-2rem); }
    100% { transform: translateX(0); }
  }

  @keyframes hero-slider-content-fade-up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-slider__controls {
    position: absolute;
    right: clamp(1.7rem, 3.4vw, 3.2rem);
    bottom: clamp(1.6rem, 3vw, 2.25rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .hero-slider__controls--left {
    right: auto;
    left: clamp(1.7rem, 3.4vw, 3.2rem);
  }

  .hero-slider__controls--center {
    right: 50%;
    transform: translateX(50%);
  }

  .hero-slider__fraction {
    display: flex;
    gap: 0.25rem;
    min-width: 2.8rem;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .hero-slider__progress {
    width: clamp(5rem, 10vw, 8.75rem);
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.22);
  }

  .hero-slider__progress span {
    display: block;
    width: 50%;
    height: 100%;
    background: #ffffff;
    transition: width var(--hero-progress-duration, 500ms) linear;
  }

  .hero-slider__arrow {
    display: grid;
    width: 1rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    place-items: center;
    transition: opacity 180ms ease;
  }

  .hero-slider__arrow:hover {
    opacity: 0.6;
  }

  .hero-slider__arrow:focus-visible,
  .hero-slider__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .hero-slider,
    .hero-slider__swiper,
    .hero-slider__slide {
      min-height: 0;
      height: 81.615vw;
    }

    .hero-slider__overlay {
      background: linear-gradient(0deg, rgb(90 90 90 / 0.3), transparent 72%);
    }

    .hero-slider__content,
    .hero-slider__content--center,
    .hero-slider__content--right {
      align-self: start;
      justify-self: center;
      width: 100%;
      padding: 1.75rem 1rem 0;
      text-align: center;
    }

    .hero-slider__heading {
      font-size: 2.25rem;
      line-height: 1.05;
    }

    .hero-slider__eyebrow {
      font-size: 0.9375rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
    }

    .hero-slider__button {
      width: 100%;
      min-width: 0;
      height: 3.125rem;
      margin-top: 2rem;
      padding-right: 3rem;
    }

    .hero-slider__controls {
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      height: 2rem;
      padding-bottom: 0;
    }

    .hero-slider__progress {
      flex: 1;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slider__button,
    .hero-slider__arrow,
    .hero-slider__progress span {
      transition: none;
    }

    .hero-slider__slide.swiper-slide-active .hero-slider__eyebrow,
    .hero-slider__slide.swiper-slide-active .hero-slider__heading,
    .hero-slider__slide.swiper-slide-active .hero-slider__button {
      animation: none;
    }

    .hero-slider__button-icon-circle svg {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initializeHeroSliders = (root = document) => {
    if (typeof window.Swiper === 'undefined') return;

    root.querySelectorAll('[data-hero-slider]').forEach((section) => {
      if (section.dataset.heroInitialized === 'true') return;

      const sliderElement = section.querySelector('.hero-slider__swiper');
      const previousButton = section.querySelector('.hero-slider__arrow--previous');
      const nextButton = section.querySelector('.hero-slider__arrow--next');
      const currentElement = section.querySelector('[data-hero-current]');
      const totalElement = section.querySelector('[data-hero-total]');
      const progressElement = section.querySelector('[data-hero-progress]');
      const slideCount = Number.parseInt(section.dataset.slideCount, 10);
      const autoplayEnabled = section.dataset.autoplay === 'true';
      const autoplayDelay = Number(section.dataset.autoplayDelay);

      if (!Number.isFinite(slideCount) || slideCount < 1) return;

      const restartProgress = () => {
        if (!progressElement) return;

        progressElement.style.setProperty(
          '--hero-progress-duration',
          autoplayEnabled && autoplayDelay > 0 ? `${autoplayDelay}ms` : '0ms'
        );
        progressElement.style.transition = 'none';
        progressElement.style.width = '0%';
        progressElement.getBoundingClientRect();
        progressElement.style.removeProperty('transition');

        if (autoplayEnabled && autoplayDelay > 0) {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              progressElement.style.width = '100%';
            });
          });
        }
      };

      const updateControls = (swiper) => {
        const currentIndex = Number(swiper.realIndex);
        const current = (Number.isFinite(currentIndex) ? currentIndex : 0) + 1;
        if (currentElement) currentElement.textContent = String(current);
        if (totalElement) totalElement.textContent = String(slideCount);
        if (autoplayEnabled) {
          restartProgress();
        } else if (progressElement) {
          progressElement.style.width = `${(current / slideCount) * 100}%`;
        }
      };

      const options = {
        effect: 'fade',
        loop: slideCount > 1,
        slidesPerView: 1,
        speed: 800,
        navigation: {
          prevEl: previousButton,
          nextEl: nextButton
        },
        on: {
          init: updateControls,
          slideChange: updateControls
        }
      };

      if (autoplayEnabled && slideCount > 1) {
        options.autoplay = {
          delay: autoplayDelay,
          disableOnInteraction: false
        };
      }

      new window.Swiper(sliderElement, options);
      section.dataset.heroInitialized = 'true';
    });
  };

  initializeHeroSliders();
  document.addEventListener('DOMContentLoaded', () => initializeHeroSliders());
  window.addEventListener('load', () => initializeHeroSliders());
  document.addEventListener('shopify:section:load', (event) => initializeHeroSliders(event.target));
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.hero_slider.name",
  "tag": "section",
  "class": "hero-slider-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.height.adapt"
        },
        {
          "value": "small",
          "label": "t:options.height.small"
        },
        {
          "value": "medium",
          "label": "t:options.height.medium"
        },
        {
          "value": "large",
          "label": "t:options.height.large"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:labels.container",
      "options": [
        {
          "value": "full",
          "label": "t:options.container.full"
        },
        {
          "value": "fixed",
          "label": "t:options.container.fixed"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "inside",
          "label": "t:options.content_position.inside"
        },
        {
          "value": "outside",
          "label": "t:options.content_position.outside"
        }
      ],
      "default": "inside"
    },
    {
      "type": "checkbox",
      "id": "header_overlay",
      "label": "t:labels.header_overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_next_overlap",
      "label": "t:labels.allow_next_overlap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "t:labels.autoplay_delay",
      "default": 5000
    },
    {
      "type": "select",
      "id": "control_type",
      "label": "t:labels.control_type",
      "options": [
        {
          "value": "default",
          "label": "t:options.control_type.default"
        },
        {
          "value": "progress_text",
          "label": "t:options.control_type.progress_text"
        }
      ],
      "default": "progress_text"
    },
    {
      "type": "select",
      "id": "control_alignment",
      "label": "t:labels.control_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "_hero-slide"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_slider.name",
      "blocks": [
        {
          "type": "_hero-slide"
        },
        {
          "type": "_hero-slide"
        }
      ]
    }
  ]
}
{% endschema %}
