<section
  class="hero-slider"
  data-hero-slider
  data-slide-count="{{ section.blocks.size }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
  style="--hero-height: {{ section.settings.height }}px;"
>
  <div class="swiper hero-slider__swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <article class="swiper-slide hero-slider__slide" {{ block.shopify_attributes }}>
          <div class="hero-slider__media">
            {% if block.settings.image != blank %}
              {% if forloop.first %}
                {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slider__image', loading: 'eager', sizes: '100vw' }}
              {% else %}
                {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slider__image', loading: 'lazy', sizes: '100vw' }}
              {% endif %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__placeholder' }}
            {% endif %}
          </div>

          <div class="hero-slider__overlay"></div>

          <div class="hero-slider__content hero-slider__content--{{ block.settings.alignment }}">
            {% if block.settings.eyebrow != blank %}
              <p class="hero-slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="hero-slider__heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a
                class="hero-slider__button"
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label | escape }}
                <span aria-hidden="true">↗</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="hero-slider__controls">
        <div class="hero-slider__fraction" aria-live="polite">
          <span data-hero-current>01</span>
          <span aria-hidden="true">/</span>
          <span data-hero-total>{{ section.blocks.size }}</span>
        </div>

        <div class="hero-slider__progress" aria-hidden="true">
          <span data-hero-progress></span>
        </div>

        <button class="hero-slider__arrow hero-slider__arrow--previous" type="button" aria-label="{{ 'buttons.previous_slide' | t }}">
          <span aria-hidden="true">←</span>
        </button>

        <button class="hero-slider__arrow hero-slider__arrow--next" type="button" aria-label="{{ 'buttons.next_slide' | t }}">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero-slider {
    position: relative;
    min-height: min(var(--hero-height), 100svh);
    overflow: hidden;
    background: #d8d6d0;
    color: #ffffff;
  }

  .hero-slider__swiper,
  .hero-slider__slide {
    min-height: min(var(--hero-height), 100svh);
  }

  .hero-slider__slide {
    position: relative;
    display: grid;
    isolation: isolate;
  }

  .hero-slider__media,
  .hero-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .hero-slider__media {
    z-index: -2;
  }

  .hero-slider__image,
  .hero-slider__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slider__placeholder {
    background: #d8d6d0;
    color: #a6a39b;
  }

  .hero-slider__overlay {
    z-index: -1;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.52), transparent 62%);
  }

  .hero-slider__content {
    align-self: end;
    width: min(100%, 46rem);
    padding: clamp(2rem, 5vw, 6rem);
    padding-bottom: clamp(7rem, 11vw, 10rem);
  }

  .hero-slider__content--center {
    justify-self: center;
    text-align: center;
  }

  .hero-slider__content--right {
    justify-self: end;
    text-align: right;
  }

  .hero-slider__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-slider__heading {
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 12rem;
    margin-top: 2rem;
    padding: 0.95rem 1.25rem;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .hero-slider__button:hover {
    transform: translateY(-2px);
    background: #f2f2f2;
  }

  .hero-slider__button[aria-disabled="true"] {
    cursor: default;
  }

  .hero-slider__controls {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    bottom: clamp(1rem, 3vw, 2.5rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-slider__fraction {
    display: flex;
    gap: 0.25rem;
    min-width: 3.25rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero-slider__progress {
    width: clamp(4rem, 8vw, 8rem);
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.4);
  }

  .hero-slider__progress span {
    display: block;
    width: 50%;
    height: 100%;
    background: #ffffff;
    transition: width 500ms ease;
  }

  .hero-slider__arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    place-items: center;
    transition: background 180ms ease, color 180ms ease;
  }

  .hero-slider__arrow:hover {
    background: #ffffff;
    color: #111111;
  }

  .hero-slider__arrow:focus-visible,
  .hero-slider__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .hero-slider__overlay {
      background: linear-gradient(0deg, rgb(0 0 0 / 0.58), transparent 72%);
    }

    .hero-slider__content {
      padding-bottom: 8.5rem;
    }

    .hero-slider__controls {
      right: 1.25rem;
      left: 1.25rem;
    }

    .hero-slider__progress {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slider__button,
    .hero-slider__arrow,
    .hero-slider__progress span {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initializeHeroSliders = (root = document) => {
    if (typeof window.Swiper === 'undefined') return;

    root.querySelectorAll('[data-hero-slider]').forEach((section) => {
      if (section.dataset.heroInitialized === 'true') return;

      const sliderElement = section.querySelector('.hero-slider__swiper');
      const previousButton = section.querySelector('.hero-slider__arrow--previous');
      const nextButton = section.querySelector('.hero-slider__arrow--next');
      const currentElement = section.querySelector('[data-hero-current]');
      const totalElement = section.querySelector('[data-hero-total]');
      const progressElement = section.querySelector('[data-hero-progress]');
      const slideCount = Number(section.dataset.slideCount);
      const autoplayEnabled = section.dataset.autoplay === 'true';
      const autoplayDelay = Number(section.dataset.autoplayDelay);

      const updateControls = (swiper) => {
        const current = swiper.realIndex + 1;
        if (currentElement) currentElement.textContent = String(current).padStart(2, '0');
        if (totalElement) totalElement.textContent = String(slideCount).padStart(2, '0');
        if (progressElement) progressElement.style.width = `${(current / slideCount) * 100}%`;
      };

      const options = {
        effect: 'fade',
        loop: slideCount > 1,
        speed: 800,
        navigation: {
          prevEl: previousButton,
          nextEl: nextButton
        },
        on: {
          init: updateControls,
          slideChange: updateControls
        }
      };

      if (autoplayEnabled && slideCount > 1) {
        options.autoplay = {
          delay: autoplayDelay,
          disableOnInteraction: false
        };
      }

      new window.Swiper(sliderElement, options);
      section.dataset.heroInitialized = 'true';
    });
  };

  initializeHeroSliders();
  document.addEventListener('DOMContentLoaded', () => initializeHeroSliders());
  window.addEventListener('load', () => initializeHeroSliders());
  document.addEventListener('shopify:section:load', (event) => initializeHeroSliders(event.target));
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.hero_slider.name",
  "tag": "section",
  "class": "hero-slider-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "height",
      "min": 500,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "t:labels.height",
      "default": 760
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "t:labels.autoplay_delay",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero_slider.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:labels.eyebrow",
          "default": "New campaign"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Softness in comfort"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:labels.button_link"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "t:labels.alignment",
          "options": [
            {
              "value": "left",
              "label": "t:options.alignment.left"
            },
            {
              "value": "center",
              "label": "t:options.alignment.center"
            },
            {
              "value": "right",
              "label": "t:options.alignment.right"
            }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_slider.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Little moments",
            "heading": "Wrapped in warmth"
          }
        }
      ]
    }
  ]
}
{% endschema %}
