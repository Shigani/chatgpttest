<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@14.0.7/swiper-bundle.min.css">
    {{ content_for_header }}
    <style>
      :root {
        color-scheme: light;
        font-family: "Bricolage Grotesque", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: #ffffff;
        color: #1f1f1f;
        font-family: "Bricolage Grotesque", sans-serif;
      }

      main {
        min-height: 100vh;
      }
    </style>
  </head>
  <body class="template-{{ template.name | handle }}">
    {% comment %}Temporarily hidden for layout review.{% endcomment %}
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
    <script src="https://cdn.jsdelivr.net/npm/swiper@14.0.7/swiper-bundle.min.js" defer></script>
  </body>
</html>
