{% if block.settings.text != blank %}
  <div class="hero-slider__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
{% endif %}

{% schema %}
{
  "name": "t:blocks.hero_text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>New campaign</p>"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero_text.name"
    }
  ]
}
{% endschema %}
