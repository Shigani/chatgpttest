      "label": "t:labels.media_overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:labels.overlay_color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:labels.alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:labels.row_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:labels.row_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:labels.width_custom",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:labels.inherit_color_scheme",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "t:labels.transparent_background",
      "default": true
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:labels.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.border.none"
        },
        {
          "value": "solid",
          "label": "t:options.border.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_slider.slide",
      "blocks": [
        {
          "type": "_hero-eyebrow"
        },
        {
          "type": "_hero-heading"
        },
        {
          "type": "_hero-button"
        }
      ]
    }
  ]
}
