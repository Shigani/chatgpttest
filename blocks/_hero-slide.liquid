Exit code: 0
Wall time: 0.8 seconds
Output:
<article
  class="swiper-slide hero-slider__slide hero-slider__slide--width-{{ block.settings.width }} hero-slider__slide--border-{{ block.settings.border }}{% if block.settings.transparent_background %} hero-slider__slide--transparent{% endif %}{% if block.settings.inherit_color_scheme %} hero-slider__slide--inherit-color-scheme{% endif %}"
  style="--hero-slide-row-gap: {{ block.settings.row_gap }}px; --hero-slide-row-gap-mobile: {{ block.settings.row_gap_mobile }}px; --hero-slide-custom-width: {{ block.settings.width_custom }}%; --hero-slide-radius: {{ block.settings.corner_radius }}px;"
  {{ block.shopify_attributes }}
>
  <div class="hero-slider__media">
    {% if block.settings.image != blank or block.settings.mobile_image != blank %}
      <picture class="hero-slider__picture">
        {% if block.settings.mobile_image != blank %}
          <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1600 }}">
        {% endif %}
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slider__image', loading: 'eager', sizes: '100vw' }}
        {% else %}
          {{ block.settings.mobile_image | image_url: width: 1600 | image_tag: class: 'hero-slider__image', loading: 'eager', sizes: '100vw' }}
        {% endif %}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__placeholder' }}
    {% endif %}
  </div>

  <div
    class="hero-slider__overlay{% unless block.settings.media_overlay %} hero-slider__overlay--hidden{% endunless %}"
    style="--hero-overlay-color: {{ block.settings.overlay_color }};"
  ></div>

  <div class="hero-slider__content hero-slider__content--{{ block.settings.alignment }} hero-slider__content--mobile-{{ block.settings.alignment_mobile }} hero-slider__content--width-{{ block.settings.width }}">
    {% content_for 'blocks' %}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.hero_slider.slide",
  "tag": null,
  "blocks": [
    {
      "type": "_hero-eyebrow"
    },
    {
      "type": "_hero-heading"
    },
    {
      "type": "_hero-button"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.desktop_image"
