{% if block.settings.label != blank %}
  <a
    class="hero-slider__button"
    {% if block.settings.link != blank %}
      href="{{ block.settings.link }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <span class="hero-slider__button-label">{{ block.settings.label | escape }}</span>
    <span class="hero-slider__button-icon" aria-hidden="true">
      <span class="hero-slider__button-icon-label">{{ block.settings.label | escape }}</span>
      <span class="hero-slider__button-icon-circle">
        <svg viewBox="0 0 20 20" role="presentation">
          <path d="m7 5 5 5-5 5"></path>
        </svg>
      </span>
    </span>
  </a>
{% endif %}

{% schema %}
{
  "name": "t:blocks.hero_button.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.button_label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.hero_button.name"
    }
  ]
}
{% endschema %}
